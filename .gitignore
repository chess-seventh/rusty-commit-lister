.DS_Store

/target
### Rust
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Coverage report. Both `test-coverage` and the CI coverage job write this
# into the tree and regenerate it from scratch every run, so a committed copy
# is stale the moment it lands - and it was committed, which is why running
# coverage locally produced a 48k diff nobody asked for.
lcov.info

.direnv

# Devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

result

.direnv*

mutants*
# nWave activation marker (keep .nwave/local-config.json trackable)
.nwave/*
!.nwave/local-config.json
